      "id": "receipt_fragment",
      "name": "レシート片",
      "description": "誰が持っていたかをミラが読み替えたとき、初めて意味を持つ破れたレシート。",
      "parentEntity": "semantic_object",
      "properties": {
        "provenance": {
          "key": "provenance",
          "type": "string",
          "defaultValue": "clocktower archive desk"
        },
        "owner": {
          "key": "owner",
          "type": "string",
          "defaultValue": "Mira's mentor"
        },
        "location": {
          "key": "location",
          "type": "string",
          "defaultValue": "south archive"
        },
        "contradiction": {
          "key": "contradiction",
